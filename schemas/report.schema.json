{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beautyproof.local/schemas/report.schema.json",
  "title": "BeautyProof Report Response",
  "type": "object",
  "required": [
    "request_id",
    "content_id",
    "report"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "content_id": {
      "type": "string"
    },
    "report": {
      "type": "object",
      "required": [
        "trust_card"
      ],
      "properties": {
        "trust_card": {
          "$ref": "trust_card.schema.json"
        }
      }
    }
  }
}
