{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beautyproof.local/schemas/trust_card.schema.json",
  "title": "BeautyProof Trust Card",
  "type": "object",
  "required": [
    "verdict",
    "verdict_label",
    "main_findings",
    "sections",
    "creator_actions",
    "advanced"
  ],
  "properties": {
    "verdict": {
      "type": "string"
    },
    "verdict_label": {
      "type": "string"
    },
    "main_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "content"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "content": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "creator_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "advanced": {
      "type": "object"
    }
  }
}
