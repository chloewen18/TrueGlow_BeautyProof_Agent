{
  "$defs": {
    "AgentDecision": {
      "description": "Main Agent 的决策记录：结论 + 风险维度 + 决策路径。",
      "properties": {
        "final_label": {
          "$ref": "#/$defs/FinalLabel"
        },
        "content_integrity_risk": {
          "description": "内容完整性风险：素材是否被加工/拼接/伪造",
          "title": "Content Integrity Risk",
          "type": "string"
        },
        "attribution_reliability": {
          "description": "妆效归因可靠性：效果能否合理归因于产品",
          "title": "Attribution Reliability",
          "type": "string"
        },
        "claim_evidence_sufficiency": {
          "description": "宣称证据充分性：文案是否得到可信证据支持",
          "title": "Claim Evidence Sufficiency",
          "type": "string"
        },
        "personal_fit_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "个人适配提示：产品是否可能符合当前用户需求",
          "title": "Personal Fit Hint"
        },
        "confidence": {
          "description": "结论置信度与局限：系统看到了什么、没有看到什么",
          "title": "Confidence",
          "type": "string"
        },
        "decision_path": {
          "description": "完整决策路径（可追溯）",
          "items": {
            "type": "string"
          },
          "title": "Decision Path",
          "type": "array"
        },
        "affected_claims": {
          "description": "受影响/存疑的功效宣称",
          "items": {
            "type": "string"
          },
          "title": "Affected Claims",
          "type": "array"
        }
      },
      "required": [
        "final_label",
        "content_integrity_risk",
        "attribution_reliability",
        "claim_evidence_sufficiency",
        "confidence"
      ],
      "title": "AgentDecision",
      "type": "object"
    },
    "BeforeAfterEvidenceLayer": {
      "description": "前后对比证据（T4 产出）。",
      "properties": {
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          },
          "title": "Items",
          "type": "array"
        },
        "raw": {
          "additionalProperties": true,
          "title": "Raw",
          "type": "object"
        }
      },
      "title": "BeforeAfterEvidenceLayer",
      "type": "object"
    },
    "CreatorSubmission": {
      "description": "创作者补证材料与复核状态。",
      "properties": {
        "status": {
          "default": "none",
          "enum": [
            "none",
            "received",
            "processing",
            "done"
          ],
          "title": "Status",
          "type": "string"
        },
        "materials": {
          "additionalProperties": true,
          "description": "原始素材/滤镜参数/拍摄参数/复测片段等",
          "title": "Materials",
          "type": "object"
        },
        "review_result": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "复核后结论变化说明",
          "title": "Review Result"
        },
        "credential": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "可信妆效凭证：验证范围、日期",
          "title": "Credential"
        }
      },
      "title": "CreatorSubmission",
      "type": "object"
    },
    "EvidenceItem": {
      "description": "单条证据：来源 Tool、可解释依据、可靠性、是否影响结论。",
      "properties": {
        "evidence_id": {
          "description": "证据唯一 ID，形如 src-001",
          "title": "Evidence Id",
          "type": "string"
        },
        "tool": {
          "description": "产生该证据的 Tool 标识",
          "title": "Tool",
          "type": "string"
        },
        "claim": {
          "description": "证据声称的内容（人类可读）",
          "title": "Claim",
          "type": "string"
        },
        "finding": {
          "additionalProperties": true,
          "description": "结构化发现（数值/分级/位置等）",
          "title": "Finding",
          "type": "object"
        },
        "reliability": {
          "$ref": "#/$defs/EvidenceReliability",
          "default": "Medium",
          "description": "该证据可靠性"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "证据来源说明，如 'EXIF 元数据' / 'TruFor inference'",
          "title": "Source"
        },
        "confidence_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "对局限性的说明，如 '平台压缩可能影响判断'",
          "title": "Confidence Note"
        }
      },
      "required": [
        "evidence_id",
        "tool",
        "claim"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "EvidenceReliability": {
      "description": "证据可靠性分级（必须与结论一起看）。",
      "enum": [
        "Low",
        "Medium",
        "High"
      ],
      "title": "EvidenceReliability",
      "type": "string"
    },
    "FinalLabel": {
      "description": "最终四级结论（见方案文档第七节）。",
      "enum": [
        "verified",
        "partially_suspicious",
        "insufficient_evidence",
        "high_risk_misleading"
      ],
      "title": "FinalLabel",
      "type": "string"
    },
    "HumanReview": {
      "description": "人工复核（阶段 2+ 使用）。",
      "properties": {
        "status": {
          "default": "none",
          "enum": [
            "none",
            "pending",
            "approved",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "title": "HumanReview",
      "type": "object"
    },
    "SourceEvidenceLayer": {
      "description": "来源证据（T2 产出）。",
      "properties": {
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          },
          "title": "Items",
          "type": "array"
        },
        "raw": {
          "additionalProperties": true,
          "title": "Raw",
          "type": "object"
        }
      },
      "title": "SourceEvidenceLayer",
      "type": "object"
    },
    "TextEvidenceLayer": {
      "description": "文本与功效证据（T5 产出）。",
      "properties": {
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          },
          "title": "Items",
          "type": "array"
        },
        "raw": {
          "additionalProperties": true,
          "title": "Raw",
          "type": "object"
        }
      },
      "title": "TextEvidenceLayer",
      "type": "object"
    },
    "ToolReliabilityMap": {
      "description": "各 Tool 结果的可靠性汇总，用于冲突处理。",
      "properties": {
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "status": {
          "default": "success",
          "title": "Status",
          "type": "string"
        },
        "reliability": {
          "$ref": "#/$defs/EvidenceReliability",
          "default": "Medium"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "tool"
      ],
      "title": "ToolReliabilityMap",
      "type": "object"
    },
    "VisualEvidenceLayer": {
      "description": "视觉证据（T3 产出）。",
      "properties": {
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          },
          "title": "Items",
          "type": "array"
        },
        "raw": {
          "additionalProperties": true,
          "title": "Raw",
          "type": "object"
        }
      },
      "title": "VisualEvidenceLayer",
      "type": "object"
    }
  },
  "description": "单条内容的结构化证据层（对应方案文档 10.1 的 evidence 结构）。",
  "properties": {
    "content_id": {
      "title": "Content Id",
      "type": "string"
    },
    "source_evidence": {
      "$ref": "#/$defs/SourceEvidenceLayer"
    },
    "visual_evidence": {
      "$ref": "#/$defs/VisualEvidenceLayer"
    },
    "before_after_evidence": {
      "$ref": "#/$defs/BeforeAfterEvidenceLayer"
    },
    "text_evidence": {
      "$ref": "#/$defs/TextEvidenceLayer"
    },
    "efficacy_evidence": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Efficacy Evidence",
      "type": "array"
    },
    "user_context": {
      "additionalProperties": true,
      "title": "User Context",
      "type": "object"
    },
    "tool_reliability": {
      "items": {
        "$ref": "#/$defs/ToolReliabilityMap"
      },
      "title": "Tool Reliability",
      "type": "array"
    },
    "agent_decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "creator_submission": {
      "$ref": "#/$defs/CreatorSubmission"
    },
    "human_review": {
      "$ref": "#/$defs/HumanReview"
    },
    "final_label": {
      "$ref": "#/$defs/FinalLabel",
      "default": "insufficient_evidence"
    }
  },
  "required": [
    "content_id"
  ],
  "title": "EvidenceLayer",
  "type": "object"
}