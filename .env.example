# ===== TrueGlow Main Agent 配置示例 =====
# 复制为 .env 后按需修改；默认解释层使用规则模板，真实视觉推理仍需本地权重

# --- 服务 ---
APP_HOST=127.0.0.1
APP_PORT=8000

# --- LLM 解释层（可插拔）---
# provider: mock | deepseek
# mock = 规则模板生成解释（零依赖，默认）
# deepseek = 调用 DeepSeek API 生成解释（OpenAI 兼容）
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60

# --- 存储 ---
# 证据层与日志输出根目录（相对 backend/ 运行目录）
DATA_DIR=./data
# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ===== 公网部署安全（本地开发可全部留空）=====
# 后端 API Key：设置后 /api/* 必须携带请求头 X-API-Key（/uploads /artifacts 除外）
BEAUTYPROOF_API_KEY=
# 前端访问口令：设置后进入工作台需先输入口令
BEAUTYPROOF_ACCESS_CODE=
# 允许的跨域来源，逗号分隔；留空 = 仅同源（推荐）
BEAUTYPROOF_CORS_ORIGINS=
# 单 IP 每分钟请求上限；0 = 关闭
BEAUTYPROOF_RATE_LIMIT_PER_MINUTE=120
# 上传文件与检测产物保留时长（小时）；0 = 不清理
BEAUTYPROOF_RUNTIME_RETENTION_HOURS=24

# ===== 前端连接后端 =====
# 前后端分开部署时，指向后端公网地址
BEAUTYPROOF_API_BASE_URL=http://127.0.0.1:8000
# true = 前端使用内置模拟数据，不请求后端
BEAUTYPROOF_USE_MOCK=false
