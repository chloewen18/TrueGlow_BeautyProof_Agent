# ===== TrueGlow Main Agent 配置示例 =====
# 复制为 .env 后按需修改；默认解释层使用规则模板，真实视觉推理仍需本地权重

# --- 服务 ---
APP_HOST=127.0.0.1
APP_PORT=8000

# --- LLM 解释层（可插拔）---
# provider: mock | deepseek
# mock = 规则模板生成解释（零依赖，默认）
# deepseek = 调用 DeepSeek API 生成解释（OpenAI 兼容）
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60

# --- 存储 ---
# 证据层与日志输出根目录（相对 backend/ 运行目录）
DATA_DIR=./data
# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
